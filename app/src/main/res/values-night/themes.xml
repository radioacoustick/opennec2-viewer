<resources>
    <!-- Base application theme. -->
    <style name="Theme.OpenNEC2Viewer" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Key Colors of the Material3 Theme -->
        <item name="colorPrimary">@color/m_primary</item>
        <item name="colorSecondary">@color/m_secondary</item>
        <item name="colorTertiary">@color/m_tertiary</item>
        <item name="colorError">@color/m_error</item>
        <item name="colorSurface">@color/m_surface</item>
        <item name="android:windowBackground">@color/m_surface</item>
