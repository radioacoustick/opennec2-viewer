<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    xmlns:tools2="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".ui.input.NecInputFragment">

    <!-- Top container with file name (hidden by default) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_file_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_file_card"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <!-- File icon -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_file_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:tint="?attr/colorPrimary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@android:drawable/ic_menu_save" />

        <!-- Text file name -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_file_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_clear_file"
            app:layout_constraintStart_toEndOf="@+id/iv_file_icon"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="cantenna_145mhz_optimized.nec" />

        <!-- Reset file button (cross) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear_file"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="0dp"
            app:icon="@android:drawable/ic_menu_close_clear_cancel"
            app:iconSize="18dp"
            app:iconTint="?attr/colorError"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- File text input field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_nec_input"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:hint="@string/text_area_hint"
        app:layout_constraintBottom_toTopOf="@+id/sw_orig_cards"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_file_header">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_nec_input"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:inputType="textMultiLine|textNoSuggestions"
            android:scrollbars="horizontal|vertical"
            android:textSize="11sp"
            tools2:ignore="TextContrastCheck" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/sw_orig_cards"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:text="@string/original_control_cards"
        app:layout_constraintBottom_toTopOf="@id/card_pattern_parameters"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_nec_input" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_pattern_parameters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/btn_calculate_main"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sw_orig_cards"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/layout_card_header"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/radiation_pattern_parameters"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorPrimary"
                    tools2:ignore="TextContrastCheck" />

                <TextView
                    android:id="@+id/tv_pattern_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Freq: 145 MHz | Scale: 1°"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="visible"
                    tools2:ignore="HardcodedText"
                    tools:visibility="visible" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_settings_icon_"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:rotation="180"
                android:src="@drawable/ic_settings"
                app:tint="?attr/colorOnSurfaceVariant"
                tools2:ignore="ContentDescription" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


    <!-- Simulation start button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_calculate_main"
        style="@style/Widget.Material3.Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:enabled="false"
        android:paddingVertical="12dp"
        android:text="@string/button_caption_pattern"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_pattern_parameters" />

</androidx.constraintlayout.widget.ConstraintLayout>