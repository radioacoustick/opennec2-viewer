 *
 * Color Material for 3D Geometry Rendering
 * 
 * Description:
 * Standard unlit/lit material used for coloring custom wireframes and solid meshes.
 * 
 * Parameters:
 * - baseColor (float4): RGBA color vector (default: solid white)
 */
material {
    name : ColorMaterial,
    shadingModel : unlit,
    blending : opaque,
    culling : none,
    doubleSided : true,
    depthWrite : true,
    requires : [
        color
    ],
    parameters : [
        {
            type : float4,
            name : baseColor
        }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        float4 vColor = getColor();
        material.baseColor = materialParams.baseColor * vColor;
    }
}
